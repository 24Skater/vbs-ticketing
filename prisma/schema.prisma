generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Admin/Staff users for system access
model User {
  id              String    @id @default(cuid())
  email           String    @unique
  passwordHash    String
  name            String
  role            UserRole  @default(STAFF)
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  sessions        Session[]
  createdTickets  Ticket[]  @relation("CreatedBy")
  verifiedTickets Ticket[]  @relation("VerifiedBy")

  @@index([email])
  @@map("users")
}

/// User sessions for authentication
model Session {
  id           String   @id @default(cuid())
  userId       String
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([refreshToken])
  @@map("sessions")
}

/// Events that tickets are sold for
model Event {
  id          String       @id @default(cuid())
  name        String
  slug        String       @unique
  description String?
  venue       String?
  eventDate   DateTime
  eventTime   String       @default("09:00 AM")
  endDate     DateTime?
  imageUrl    String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  ticketTypes TicketType[]
  tickets     Ticket[]

  @@index([slug])
  @@index([eventDate])
  @@map("events")
}

/// Ticket type definitions per event (VIP, Regular, etc.)
model TicketType {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  price       Int
  quantity    Int
  sold        Int      @default(0)
  description String?
  isActive    Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets     Ticket[]

  @@unique([eventId, name])
  @@index([eventId])
  @@map("ticket_types")
}

/// Individual tickets
model Ticket {
  id           String       @id @default(cuid())
  ticketId     String       @unique
  accessCode   String       @unique
  eventId      String?
  ticketTypeId String?
  name         String
  phone        String
  email        String?
  status       TicketStatus @default(PENDING)
  amount       Int          @default(0)
  used         Boolean      @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  notes        String?
  createdById  String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  payments     Payment[]
  createdBy    User?        @relation("CreatedBy", fields: [createdById], references: [id])
  event        Event?       @relation(fields: [eventId], references: [id])
  ticketType   TicketType?  @relation(fields: [ticketTypeId], references: [id])
  verifiedBy   User?        @relation("VerifiedBy", fields: [verifiedById], references: [id])

  @@index([ticketId])
  @@index([accessCode])
  @@index([phone])
  @@index([eventId])
  @@index([status])
  @@map("tickets")
}

/// Payment transactions
model Payment {
  id              String              @id @default(cuid())
  ticketId        String
  amount          Int
  currency        String              @default("USD")
  status          PaymentStatus       @default(PENDING)
  provider        PaymentProviderType @default(MANUAL)
  reference       String?         @unique
  externalId      String?
  channel         String?
  customerMsisdn  String?
  customerName    String?
  providerMessage String?
  metadata        Json?
  paidAt          DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  ticket          Ticket          @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([reference])
  @@index([externalId])
  @@index([status])
  @@map("payments")
}

/// Audit log for important actions
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// User roles for access control
enum UserRole {
  SUPER_ADMIN
  ADMIN
  STAFF
  CHECKER
}

/// Ticket status enumeration
enum TicketStatus {
  PENDING
  PAID
  USED
  CANCELLED
  REFUNDED
  EXPIRED
}

/// Payment status enumeration
enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

/// Payment provider enumeration
enum PaymentProviderType {
  HUBTEL
  STRIPE
  PAYPAL
  SQUARE
  PAYSTACK
  FLUTTERWAVE
  MANUAL
  COMPLIMENTARY
}

// ============================================================================
// SITE CONFIGURATION
// ============================================================================

/// Site-wide configuration (singleton)
model SiteConfig {
  id          String   @id @default("default")
  
  // Organization Info
  orgName        String   @default("My Organization")
  orgSlug        String   @unique @default("my-org")
  orgDescription String?
  orgWebsite     String?
  orgEmail       String?
  orgPhone       String?
  orgAddress     String?
  
  // Localization
  timezone       String   @default("UTC")
  locale         String   @default("en-US")
  language       String   @default("en")
  currency       String   @default("USD")
  currencySymbol String   @default("$")
  dateFormat     String   @default("MM/DD/YYYY")
  timeFormat     String   @default("12h") // "12h" or "24h"
  
  // Branding - Colors
  primaryColor     String   @default("#3b82f6")
  secondaryColor   String   @default("#1e293b")
  accentColor      String   @default("#10b981")
  backgroundColor  String   @default("#0f172a")
  surfaceColor     String   @default("#1e293b")
  textColor        String   @default("#f8fafc")
  textMutedColor   String   @default("#94a3b8")
  
  // Branding - Typography
  headingFont    String   @default("Inter")
  bodyFont       String   @default("Inter")
  borderRadius   String   @default("md") // none, sm, md, lg, full
  
  // Branding - Assets (URLs)
  logoUrl        String?
  logoDarkUrl    String?
  faviconUrl     String?
  heroImageUrl   String?
  
  // Content
  homePageTitle    String   @default("Welcome")
  homePageSubtitle String?
  footerText       String   @default("Powered by VBS Ticketing")
  
  // Feature Flags
  enablePayments           Boolean @default(true)
  enableQrCodes            Boolean @default(true)
  enablePdfTickets         Boolean @default(true)
  enableEmailNotifications Boolean @default(false)
  enableSmsNotifications   Boolean @default(false)
  enablePublicEventList    Boolean @default(true)
  enableTicketLookup       Boolean @default(true)
  maintenanceMode          Boolean @default(false)
  
  // SEO & Meta
  metaTitle       String?
  metaDescription String?
  metaKeywords    String?
  socialImageUrl  String?
  
  // Custom Code (use with caution)
  customCss       String?
  customHeadHtml  String?
  
  // Timestamps
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  @@map("site_config")
}

/// Configured payment providers
model PaymentProviderConfig {
  id          String  @id @default(cuid())
  
  // Provider Identity
  provider      PaymentProviderType
  displayName   String
  enabled       Boolean @default(false)
  isDefault     Boolean @default(false)
  sortOrder     Int     @default(0)
  
  // Encrypted Configuration (API keys, secrets)
  config        Json    @default("{}")
  
  // Supported Features
  supportsCreditCard   Boolean @default(false)
  supportsDebitCard    Boolean @default(false)
  supportsMobileMoney  Boolean @default(false)
  supportsBankTransfer Boolean @default(false)
  supportsWallet       Boolean @default(false)
  
  // Geographic Restrictions
  currencies     String[] @default([])  // ["USD", "EUR", "GHS"]
  countries      String[] @default([])  // ["US", "GB", "GH"]
  
  // Fees (optional, for display)
  feePercent     Float?   // e.g., 2.9
  feeFixed       Int?     // in smallest currency unit, e.g., 30 cents
  
  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@unique([provider])
  @@index([enabled])
  @@map("payment_provider_configs")
}

/// Media/File uploads
model Upload {
  id          String   @id @default(cuid())
  
  filename    String   // Original filename
  key         String   @unique // Storage key/path
  url         String   // Public URL
  mimeType    String
  size        Int      // Bytes
  
  // Categorization
  category    String?  // "logo", "hero", "event", etc.
  
  // Metadata
  width       Int?     // For images
  height      Int?
  altText     String?
  
  uploadedBy  String?  // User ID
  
  createdAt   DateTime @default(now())
  
  @@index([category])
  @@map("uploads")
}
